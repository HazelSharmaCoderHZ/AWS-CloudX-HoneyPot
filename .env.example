# HaaS environment configuration (placeholders only — copy to .env and fill in)
# NEVER commit a real .env with live credentials.

# ── Mode ────────────────────────────────────────────────────────────────────
# local  → LocalStack via `docker compose up` (default)
# real   → Real AWS account via ./scripts/deploy_aws.sh
AWS_MODE=local

# ── Real AWS (only used when AWS_MODE=real) ─────────────────────────────────
# Leave blank to use the standard AWS credential chain:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, or
#   ~/.aws/credentials, or an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # optional, for temporary credentials
AWS_REGION=us-east-1

# ── Resource names (kept identical across local & real modes) ────────────────
# HAA_S3_BUCKET=honeypot-logs-2025
# HAA_DYNAMODB_TABLE=CowrieLogs
# HAA_IAM_ROLE=lambda-exec-role
# HAA_PARSER_LAMBDA=CowrieLogParser
# HAA_CLOUDWATCH_LAMBDA=LogDynamoDBToCloudWatch

# ── Lambda runtime ──────────────────────────────────────────────────────────
# HAA_LAMBDA_RUNTIME=python3.11
# HAA_LAMBDA_TIMEOUT=30
# HAA_LAMBDA_BATCH_SIZE=10

# ── LocalStack endpoint (only used when AWS_MODE=local) ─────────────────────
# AWS_ENDPOINT_URL=http://localhost:4566